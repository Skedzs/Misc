-- Notification System
local Notification
pcall(function()
    loadstring(game:HttpGet("https://raw.githubusercontent.com/Skedzs/Misc/refs/heads/main/Notification/Holder"))()
    Notification = loadstring(game:HttpGet("https://raw.githubusercontent.com/Skedzs/Misc/refs/heads/main/Notification/Notif"))()
end)

local function notify(title, content, duration)
    if Notification and Notification.Notify then
        Notification:Notify({ Title = title, Description = content }, { OutlineColor = Color3.fromRGB(100, 100, 100), Time = duration or 5, Type = "default" })
    end
end

-- Anti-AFK
local Players = game:GetService("Players")
local vu = game:GetService("VirtualUser")
local localPlayer = Players.LocalPlayer
local sharedEnv = (type(getgenv) == "function" and getgenv()) or _G

if typeof(sharedEnv._SkedzSpeedHubAfkConn) == "RBXScriptConnection" then
    pcall(function()
        sharedEnv._SkedzSpeedHubAfkConn:Disconnect()
    end)
    sharedEnv._SkedzSpeedHubAfkConn = nil
end

if localPlayer then
    sharedEnv._SkedzSpeedHubAfkConn = localPlayer.Idled:Connect(function()
        local cam = workspace.CurrentCamera
        local targetCFrame = cam and cam.CFrame or CFrame.new()
        vu:CaptureController()
        vu:Button2Down(Vector2.new(0, 0), targetCFrame)
        task.wait(1)
        vu:Button2Up(Vector2.new(0, 0), targetCFrame)
    end)
end

notify("Skedz Hub", "Anti-AFK automatically activated.", 3)
