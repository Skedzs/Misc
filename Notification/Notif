local Nofitication = {}
local ActiveHandles = {}

local function getNotificationGui()
    if type(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and typeof(hui) == "Instance" then
            local found = hui:FindFirstChild("STX_Nofitication")
            if found then
                return found
            end
        end
    end
    if type(cloneref) == "function" then
        local ok, cloned = pcall(cloneref, game:GetService("CoreGui"))
        if ok and typeof(cloned) == "Instance" then
            local found = cloned:FindFirstChild("STX_Nofitication")
            if found then
                return found
            end
        end
    end
    local okCore, coreGui = pcall(function()
        return game:GetService("CoreGui")
    end)
    if okCore and coreGui then
        local found = coreGui:FindFirstChild("STX_Nofitication")
        if found then
            return found
        end
    end
    local players = game:GetService("Players")
    local lp = players.LocalPlayer
    local playerGui = lp and lp:FindFirstChildOfClass("PlayerGui")
    return playerGui and playerGui:FindFirstChild("STX_Nofitication") or nil
end

function Nofitication:DismissAll()
    local handles = {}
    for handle in pairs(ActiveHandles) do
        table.insert(handles, handle)
    end
    for _, handle in ipairs(handles) do
        if type(handle.Dismiss) == "function" then
            pcall(handle.Dismiss, handle)
        end
    end
end

function Nofitication:Notify(nofdebug, middledebug, all)
    local GUI = getNotificationGui()
    if not GUI then
        return nil
    end
    local SelectedType = string.lower(tostring((middledebug and middledebug.Type) or "default"))
    local ambientShadow = Instance.new("ImageLabel")
    local Window = Instance.new("Frame")
    local Outline_A = Instance.new("Frame")
    local WindowTitle = Instance.new("TextLabel")
    local WindowDescription = Instance.new("TextLabel")

    ambientShadow.Name = "ambientShadow"
    ambientShadow.Parent = GUI
    ambientShadow.AutoLocalize = false
    ambientShadow.AnchorPoint = Vector2.new(0.5, 0.5)
    ambientShadow.BackgroundTransparency = 1.000
    ambientShadow.BorderSizePixel = 0
    ambientShadow.Position = UDim2.new(0.91525954, 0, 0.936809778, 0)
    ambientShadow.Size = UDim2.new(0, 0, 0, 0)
    ambientShadow.Image = "rbxassetid://1316045217"
    ambientShadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
    ambientShadow.ImageTransparency = 0.400
    ambientShadow.ScaleType = Enum.ScaleType.Slice
    ambientShadow.SliceCenter = Rect.new(10, 10, 118, 118)

    Window.Name = "Window"
    Window.Parent = ambientShadow
    Window.AutoLocalize = false
    Window.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    Window.BorderSizePixel = 0
    Window.Position = UDim2.new(0, 5, 0, 5)
    Window.Size = UDim2.new(0, 230, 0, 80)
    Window.ZIndex = 2

    Outline_A.Name = "Outline_A"
    Outline_A.Parent = Window
    Outline_A.AutoLocalize = false
    Outline_A.BackgroundColor3 = (middledebug and middledebug.OutlineColor) or Color3.fromRGB(100, 100, 100)
    Outline_A.BorderSizePixel = 0
    Outline_A.Position = UDim2.new(0, 0, 0, 25)
    Outline_A.Size = UDim2.new(0, 230, 0, 2)
    Outline_A.ZIndex = 5

    WindowTitle.Name = "WindowTitle"
    WindowTitle.Parent = Window
    WindowTitle.AutoLocalize = false
    WindowTitle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    WindowTitle.BackgroundTransparency = 1.000
    WindowTitle.BorderColor3 = Color3.fromRGB(27, 42, 53)
    WindowTitle.BorderSizePixel = 0
    WindowTitle.Position = UDim2.new(0, 8, 0, 2)
    WindowTitle.Size = UDim2.new(0, 222, 0, 22)
    WindowTitle.ZIndex = 4
    WindowTitle.Font = Enum.Font.GothamSemibold
    WindowTitle.Text = (nofdebug and nofdebug.Title) or ""
    WindowTitle.TextColor3 = Color3.fromRGB(220, 220, 220)
    WindowTitle.TextSize = 12.000
    WindowTitle.TextXAlignment = Enum.TextXAlignment.Left

    WindowDescription.Name = "WindowDescription"
    WindowDescription.Parent = Window
    WindowDescription.AutoLocalize = false
    WindowDescription.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    WindowDescription.BackgroundTransparency = 1.000
    WindowDescription.BorderColor3 = Color3.fromRGB(27, 42, 53)
    WindowDescription.BorderSizePixel = 0
    WindowDescription.Position = UDim2.new(0, 8, 0, 34)
    WindowDescription.Size = UDim2.new(0, 216, 0, 40)
    WindowDescription.ZIndex = 4
    WindowDescription.Font = Enum.Font.GothamSemibold
    WindowDescription.Text = (nofdebug and nofdebug.Description) or ""
    WindowDescription.TextColor3 = Color3.fromRGB(180, 180, 180)
    WindowDescription.TextSize = 12.000
    WindowDescription.TextWrapped = true
    WindowDescription.TextXAlignment = Enum.TextXAlignment.Left
    WindowDescription.TextYAlignment = Enum.TextYAlignment.Top

    local dismissed = false
    local handle = {
        Instance = ambientShadow
    }
    ActiveHandles[handle] = true

    function handle:Dismiss()
        if dismissed then
            return
        end
        dismissed = true
        ActiveHandles[handle] = nil
        if ambientShadow and ambientShadow.Parent then
            pcall(function()
                ambientShadow:TweenSize(UDim2.new(0, 0, 0, 0), "Out", "Linear", 0.2, true)
            end)
            task.delay(0.2, function()
                if ambientShadow and ambientShadow.Parent then
                    ambientShadow:Destroy()
                end
            end)
        end
    end

    local function scheduleAutoDismiss(duration)
        task.spawn(function()
            local total = tonumber(duration) or 5
            if total > 0 then
                pcall(function()
                    Outline_A:TweenSize(UDim2.new(0, 0, 0, 2), "Out", "Linear", total, true)
                end)
                local deadline = tick() + total
                while not dismissed and ambientShadow.Parent and tick() < deadline do
                    task.wait(0.2)
                end
            end
            if not dismissed then
                handle:Dismiss()
            end
        end)
    end

    if SelectedType == "default" then
        ambientShadow:TweenSize(UDim2.new(0, 240, 0, 90), "Out", "Linear", 0.2, true)
        Window.Size = UDim2.new(0, 230, 0, 80)
        scheduleAutoDismiss(middledebug and middledebug.Time)
    elseif SelectedType == "image" then
        ambientShadow:TweenSize(UDim2.new(0, 240, 0, 90), "Out", "Linear", 0.2, true)
        Window.Size = UDim2.new(0, 230, 0, 80)
        WindowTitle.Position = UDim2.new(0, 24, 0, 2)
        local ImageButton = Instance.new("ImageButton")
        ImageButton.Parent = Window
        ImageButton.AutoLocalize = false
        ImageButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        ImageButton.BackgroundTransparency = 1.000
        ImageButton.BorderSizePixel = 0
        ImageButton.Position = UDim2.new(0, 4, 0, 4)
        ImageButton.Size = UDim2.new(0, 18, 0, 18)
        ImageButton.ZIndex = 5
        ImageButton.AutoButtonColor = false
        ImageButton.Image = (all and all.Image) or ""
        ImageButton.ImageColor3 = (all and all.ImageColor) or Color3.fromRGB(255, 255, 255)
        scheduleAutoDismiss(middledebug and middledebug.Time)
    elseif SelectedType == "option" then
        ambientShadow:TweenSize(UDim2.new(0, 240, 0, 110), "Out", "Linear", 0.2, true)
        Window.Size = UDim2.new(0, 230, 0, 100)
        local Uncheck = Instance.new("ImageButton")
        local Check = Instance.new("ImageButton")

        Uncheck.Name = "Uncheck"
        Uncheck.Parent = Window
        Uncheck.AutoLocalize = false
        Uncheck.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        Uncheck.BackgroundTransparency = 1.000
        Uncheck.BorderSizePixel = 0
        Uncheck.Position = UDim2.new(0, 7, 0, 76)
        Uncheck.Size = UDim2.new(0, 18, 0, 18)
        Uncheck.ZIndex = 5
        Uncheck.AutoButtonColor = false
        Uncheck.Image = "http://www.roblox.com/asset/?id=6031094678"
        Uncheck.ImageColor3 = Color3.fromRGB(255, 84, 84)

        Check.Name = "Check"
        Check.Parent = Window
        Check.AutoLocalize = false
        Check.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        Check.BackgroundTransparency = 1.000
        Check.BorderSizePixel = 0
        Check.Position = UDim2.new(0, 28, 0, 76)
        Check.Size = UDim2.new(0, 18, 0, 18)
        Check.ZIndex = 5
        Check.AutoButtonColor = false
        Check.Image = "http://www.roblox.com/asset/?id=6031094667"
        Check.ImageColor3 = Color3.fromRGB(83, 230, 50)

        Uncheck.MouseButton1Click:Connect(function()
            if dismissed then
                return
            end
            pcall(function()
                if all and all.Callback then
                    all.Callback(false)
                end
            end)
            handle:Dismiss()
        end)

        Check.MouseButton1Click:Connect(function()
            if dismissed then
                return
            end
            pcall(function()
                if all and all.Callback then
                    all.Callback(true)
                end
            end)
            handle:Dismiss()
        end)

        scheduleAutoDismiss(middledebug and middledebug.Time)
    end

    return handle
end

return Nofitication
